#!/bin/csh
#
# perform OPLS-AA optimization
# with Fletcher-Powell optimizer
echo  OPLS-AAP Fletcher-Powell optimization
#
# usage - xPOPTF moleculename
#
# test if the enviroment variable BOSSdir has been defined
#
if (!($?BOSSdir)) then
   echo "BOSSdir has not been defined; please see README"
   exit (-1)
endif

if (-e optzmat) rm optzmat
cp ${argv[1]}.z optzmat
csh $BOSSdir/scripts/POPTFcmd >& log
rm optzmat
cp sum optzmat
csh $BOSSdir/scripts/POPTFcmd >& log
rm optzmat
echo  output is in out, sum and plt.pdb
grep "Polarization en" out
grep "Total En" out
#
exit
