#!/bin/csh
set echo
#
# script to run a MC simulation for a slab     
#
# usage:  xSLAB moleculename
# or to run in background: xSLAB moleculename &
#
# make subdirectory
#
mkdir $argv[1]
cd $argv[1]
#
# moleculename.z is copied from above           
#
cp ../${argv[1]}.z slzmat        
cp ../slcmd .
cp ../slpar .
# execute MC
csh slcmd >& log
cd ..
#
exit
