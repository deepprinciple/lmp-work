#!/bin/csh
#
#   simple script to copy all necessary file from the
#   test job fepcap to execute an fep calculation.
#   only the the Z-matrix needs to be present in the current
#   directory.
#
#   Useage, e.g. for the Z-matrix zmat.z
#           xFEPCAP zmat
#
#
echo 'starting aqueous fep job'
mkdir $argv[1].aq
cd $argv[1].aq
cp ../${argv[1]}.z fepzmat
cp $BOSSdir/testjobs/fepcap/f* .
csh fepcmd >& log
#
rm  *a
rm  *b
rm  *c
rm  *eq
rm  *otd
rm  *pltd
rm  feppar*
#
grep DeltaG f*sum >>aqsum
cp aqsum delgsum
$BOSSdir/miscexec/sumdelg
rm delgsum
echo 'finished aqueous fep job'
cd ..
#
exit
