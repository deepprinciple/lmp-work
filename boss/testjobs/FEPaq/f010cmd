#
# Command file for the BOSS program.  Execute by entering the following:
# csh f010cmd >& f010log &
# Just need to copy solute zmat to fepzmat, then execute.
#***********************************************************************
echo '                       MC/FEP                '
echo '                    25 C & 1 atm '
echo '                 Equilibration 1000K '
echo '              Averaging     0000-2000K '
#***********************************************************************
#!/bin/csh -f
#
nice +19
set boss = $BOSSdir/BOSS
set configurations = "250000"
set lambda = "0.100 0.000 0.200"
set boxes = $BOSSdir
setenv INFILE    f010in
setenv UPFILE    f010up
setenv SAVE      f010sv
setenv AVERAGE   f010av
setenv ZMATRIX   fepzmat
setenv SLVZMAT   slvzmat

if (-e tmppar) rm tmppar
cp feppar0 tmppar
cat $BOSSdir/oplsaa.par >> tmppar
setenv PARAMETER tmppar

setenv BANGPAR   $boxes/oplsaa.sb
setenv WATERBOX  $boxes/watbox
setenv ORG1BOX   $boxes/org1box
setenv ORG2BOX   $boxes/org2box
setenv SUMMARY   f010sum

date

#    Equilibration

setenv OUTPUT    f010ota
setenv PLTFILE   f010plta
time $boss 110 $configurations $lambda
foreach block (b c eq)
        date
	setenv OUTPUT    f010ot$block
	setenv PLTFILE   f010plt$block
	time $boss 001 $configurations $lambda
end

#    Averaging

setenv OUTPUT    f010ota
setenv PLTFILE   f010plta
time $boss 011 $configurations $lambda
mv f010sv f010sav
foreach block (b c e1 a b c e2)
        date
        setenv OUTPUT    f010ot$block
        setenv PLTFILE   f010plt$block
        time $boss 001 $configurations $lambda
        cat f010sv >>f010sav
end

rm f010sv slvzmat tmppar *a *b *c *e1
date
exit
