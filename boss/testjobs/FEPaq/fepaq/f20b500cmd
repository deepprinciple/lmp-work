#
# Command file for the MCPRO  program.  Execute by entering the following:
# csh f20b500cmd >& log &
#***********************************************************************
echo '                    MC/FEP simulation'
echo '                 Equilibration  6M/3M  '
echo '                    Averaging  500M '
echo '                  20 Backward Windows '
#***********************************************************************
# wlj sept 2022
#
nice +19
set BOSS = $BOSSdir/BOSS 
setenv BANGPAR   $BOSSdir/oplsaa.sb
setenv WATERBOX  $BOSSdir/watbox
setenv ORG1BOX   $BOSSdir/org1box
setenv ORG2BOX   $BOSSdir/org2box
setenv SLVZMAT   slvzmat
setenv ZMATRIX   fepzmat

@ nsteps = 20            
##### Enter a loop. Repeat until i < nsteps.
@ i = 0
while ($i < $nsteps)
# set lambda values

        if ($i == 0) then
           set rc0 = "1.000"                   
           set rc1 = "0.950"                  
           set rc2 = "1.000"                    
           set lab = "100"
           set nex = "95"
	 # The feppar0 file is only used for this initial window; feppar
	 # is used for subsequent windows. The difference is that the
	 # subsequent windows use ZIN and IN for the initial solute and
	 # solvent coordinates, while here they come from ZMAT and MCPdir.
           if (-e tmppar) rm tmppar
           cp feppar0 tmppar
           cat $BOSSdir/oplsaa.par >> tmppar
#          optional:
#          use stored 25 A water cluster for initial solvent coordinates
#          cp $BOSSdir/solbox/wcapin.25 f${lab}in
        endif
        if ($i == 1) then
           set rc0 = "0.950"                   
           set rc1 = "0.900"                  
           set rc2 = "0.950"                    
           set lab = "95"
           set nex = "90"
           rm tmppar
           cp feppar tmppar
           cat $BOSSdir/oplsaa.par >> tmppar
        endif
        if ($i == 2) then
           set rc0 = "0.900"                   
           set rc1 = "0.850"                  
           set rc2 = "0.900"                    
           set lab = "90"
           set nex = "85"
        endif
        if ($i == 3) then
           set rc0 = "0.850"                   
           set rc1 = "0.800"                  
           set rc2 = "0.850"                    
           set lab = "85"
           set nex = "80"
        endif
        if ($i == 4) then
           set rc0 = "0.800"                   
           set rc1 = "0.750"                  
           set rc2 = "0.800"                    
           set lab = "80"
           set nex = "75"
        endif
        if ($i == 5) then
           set rc0 = "0.750"                   
           set rc1 = "0.700"                  
           set rc2 = "0.750"                    
           set lab = "75"
           set nex = "70"
        endif
        if ($i == 6) then
           set rc0 = "0.700"                   
           set rc1 = "0.650"                  
           set rc2 = "0.700"                    
           set lab = "70"
           set nex = "65"
        endif
        if ($i == 7) then
           set rc0 = "0.650"                   
           set rc1 = "0.600"                  
           set rc2 = "0.650"                    
           set lab = "65"
           set nex = "60"
        endif
        if ($i == 8) then
           set rc0 = "0.600"                   
           set rc1 = "0.550"                  
           set rc2 = "0.600"                    
           set lab = "60"
           set nex = "55"
        endif
        if ($i == 9) then
           set rc0 = "0.550"                   
           set rc1 = "0.500"                  
           set rc2 = "0.550"                    
           set lab = "55"
           set nex = "50"
        endif
        if ($i == 10) then
           set rc0 = "0.500"                   
           set rc1 = "0.450"                  
           set rc2 = "0.500"                    
           set lab = "50"
           set nex = "45"
        endif
        if ($i == 11) then
           set rc0 = "0.450"                   
           set rc1 = "0.400"                  
           set rc2 = "0.450"                    
           set lab = "45"
           set nex = "40"
        endif
        if ($i == 12) then
           set rc0 = "0.400"                   
           set rc1 = "0.350"                  
           set rc2 = "0.400"                    
           set lab = "40"
           set nex = "35"
        endif
        if ($i == 13) then
           set rc0 = "0.350"                   
           set rc1 = "0.300"                  
           set rc2 = "0.350"                    
           set lab = "35"
           set nex = "30"
        endif
        if ($i == 14) then
           set rc0 = "0.300"                   
           set rc1 = "0.250"                  
           set rc2 = "0.300"                    
           set lab = "30"
           set nex = "25"
        endif
        if ($i == 15) then
           set rc0 = "0.250"                   
           set rc1 = "0.200"                  
           set rc2 = "0.250"                    
           set lab = "25"
           set nex = "20"
        endif
        if ($i == 16) then
           set rc0 = "0.200"                   
           set rc1 = "0.150"                  
           set rc2 = "0.200"                    
           set lab = "20"
           set nex = "15"
        endif
        if ($i == 17) then
           set rc0 = "0.150"                   
           set rc1 = "0.100"                  
           set rc2 = "0.150"                    
           set lab = "15"
           set nex = "10"
        endif
        if ($i == 18) then
           set rc0 = "0.100"                   
           set rc1 = "0.050"                  
           set rc2 = "0.100"                    
           set lab = "10"
           set nex = "05"
        endif
        if ($i == 19) then
           set rc0 = "0.050"                   
           set rc1 = "0.000"                  
           set rc2 = "0.050"                    
           set lab = "05"
           set nex = "00"
        endif

	setenv INFILE    f${lab}in
	setenv UPFILE    f${lab}up
	setenv SAVE      f${lab}sv
	setenv AVERAGE   f${lab}av
	setenv SUMMARY   f${lab}sum
        setenv PARAMETER tmppar

#    Equilibration   #

	date
        set configurations = "1000000"
#       equilibrate longer for the first window
        if ($i == 0) set configurations = "2000000"
#       don't waste time doing the perturbations during equilibration
        set lambda = "$rc0 $rc0 $rc0"
	setenv OUTPUT    f${lab}ota
	setenv PLTFILE   f${lab}plta
        echo time $BOSS 111 $configurations $lambda
	time $BOSS 111 $configurations $lambda
	setenv OUTPUT    f${lab}otb
	setenv PLTFILE   f${lab}pltb
	time $BOSS 011 $configurations $lambda
	foreach block (eq)
        	date
		setenv OUTPUT    f${lab}ot$block
		setenv PLTFILE   f${lab}plt$block
                echo time $BOSS 001 $configurations $lambda
		time $BOSS 001 $configurations $lambda
	end

#    Averaging   #

#       reset lambda for FEP
        set lambda = "$rc0 $rc1 $rc2"
        set configurations = "50000000"
        rm f${lab}sv

	setenv OUTPUT    f${lab}ota
	setenv PLTFILE   f${lab}plta
        echo time $BOSS 011 $configurations $lambda
	time $BOSS 011 $configurations $lambda
	foreach block (b c d e250 a b c d e500)
        	date
        	setenv OUTPUT    f${lab}ot$block
        	setenv PLTFILE   f${lab}plt$block
                echo time $BOSS 001 $configurations $lambda
        	time $BOSS 001 $configurations $lambda
	end
        rm f${lab}*a f${lab}*b f${lab}*c f${lab}*d

        if ($i < ($nsteps - 1)) cp f${lab}in f${nex}in

	##### increment 'i' by one.
	@ i++
end

rm slvzmat

date
exit
