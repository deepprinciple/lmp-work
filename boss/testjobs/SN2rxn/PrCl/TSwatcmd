# 
# Command file for the BOSS  program.  Execute by entering the following:
# csh -e TSwatcmd >& log &      
#***********************************************************************
echo '        MC simulation: pmf for SN2 TS Location'
echo '                    25 C & 1 atm '
echo '                 Equilibration  2.5M '
echo '                   Averaging  0-5M '
echo '        TIP4P: N = 740  T=25  P=1  Rcut = 10 '
#***********************************************************************
#
nice +19
set boss = $BOSSdir/BOSS
set configurations = "500000"

# nsteps is the number of runs (allowed values: 1,2,5,10,25,50)
set nsteps =  10
# inc is the lambda increment x 100 - must be an integer
@ inc = 50 / $nsteps
@ lam0 = $inc
set boxes = $BOSSdir
#
##### Enter a loop. Repeat until i < nsteps.
set i = 0
while ($i < $nsteps)

setenv INFILE    d${lam0}in
setenv UPFILE    d${lam0}up
setenv SAVE      d${lam0}sv
setenv AVERAGE   d${lam0}av
setenv ZMATRIX   TSzmat
setenv SLVZMAT   slvzmat
setenv BANGPAR   $boxes/oplsaa.sb
setenv WATERBOX  $boxes/watbox
setenv ORG1BOX   $boxes/org1box
setenv ORG2BOX   $boxes/org2box
setenv SUMMARY   d${lam0}sum

/bin/cp -f pmfpar tmppar
cat $BOSSdir/oplsaa.par >> tmppar
setenv PARAMETER tmppar

# compute lambda values - csh doesn't know floating point, so
        @ lam1 = $lam0 - $inc   
        @ lam2 = $lam0 + $inc  
        @ int0 = $lam0 / 100
        @ dec0 = $lam0 - $int0 * 100
        @ ten0 = $dec0 / 10
        @ hun0 = $dec0 - $ten0 * 10
        @ int1 = $lam1 / 100
        @ dec1 = $lam1 - $int1 * 100
        @ ten1 = $dec1 / 10
        @ hun1 = $dec1 - $ten1 * 10
        @ int2 = $lam2 / 100
        @ dec2 = $lam2 - $int2 * 100
        @ ten2 = $dec2 / 10
        @ hun2 = $dec2 - $ten2 * 10

        set rc0 = ${int0}.${ten0}${hun0}
        set rc1 = ${int1}.${ten1}${hun1}
        set rc2 = ${int2}.${ten2}${hun2}
        set lambda = "$rc0 $rc1 $rc2"

date

setenv OUTPUT    d${lam0}ota
setenv PLTFILE   d${lam0}plta

#    Equilibration

time $boss 111 $configurations $lambda
foreach block (b c d eq)
        date
	setenv OUTPUT    d${lam0}ot$block
	setenv PLTFILE   d${lam0}plt$block
	time $boss 001 $configurations $lambda
end

#    Averaging    

setenv OUTPUT    d${lam0}ota
setenv PLTFILE   d${lam0}plta
time $boss 011 $configurations $lambda
/bin/cp -f d${lam0}sv d${lam0}sav
foreach block (b c e2 a b c d a e5)
        date
        setenv OUTPUT    d${lam0}ot$block
        setenv PLTFILE   d${lam0}plt$block
        time $boss 001 $configurations $lambda
        cat d${lam0}sv >>d${lam0}sav
end

rm d${lam0}sv 
rm *otb *otc *otd *ota *sav *e2 *eq
rm *plta *pltb *pltc *pltd

        set oldinc = $lam0

        ##### lam0 is incremented 
        @ lam0  = $lam0 +  2 * $inc
        /bin/cp -f d${oldinc}in d${lam0}in

        ##### increment 'i' by one.
        @ i++
end
rm tmppar
date
exit
