#
# Command file for the MCPRO  program.  Execute by entering the following:
# csh gas2cmd >& log &
#***********************************************************************
echo '                    MC/FEP simulation'
echo '                 Equilibration  0.2 M  '
echo '                    Averaging   2 M '
echo '                      2 DW Windows '
#***********************************************************************
# wlj Jan 2019
#
nice +19
set BOSS = $BOSSdir/BOSS 
setenv BANGPAR   $BOSSdir/oplsaa.sb
setenv WATERBOX  $BOSSdir/watbox
setenv ORG1BOX   $BOSSdir/org1box
setenv ORG2BOX   $BOSSdir/org2box
setenv SLVZMAT   slvzmat
setenv ZMATRIX   gaszmat

@ nsteps = 2             
##### Enter a loop. Repeat until i < nsteps.
@ i = 0
while ($i < $nsteps)
# set lambda values

        if ($i == 0) then
           set rc0 = "0.250"                   
           set rc1 = "0.000"                  
           set rc2 = "0.500"                    
           set lab = "25"
           set nex = "75"
	 # The gaspar0 file is only used for this initial window; gaspar
	 # is used for subsequent windows. The difference is that the
	 # subsequent windows use ZIN and IN for the initial solute and
	 # solvent coordinates, while here they come from ZMAT and MCPdir.
           if (-e tmppar) rm tmppar
           cp gaspar0 tmppar
           cat $BOSSdir/oplsaa.par >> tmppar
        endif
        if ($i == 1) then
           set rc0 = "0.750"                   
           set rc1 = "0.500"                  
           set rc2 = "1.000"                    
           set lab = "75"
           set nex = "100"
           rm tmppar
           cp gaspar tmppar
           cat $BOSSdir/oplsaa.par >> tmppar
        endif
	setenv INFILE    g${lab}in
	setenv UPFILE    g${lab}up
	setenv SAVE      g${lab}sv
	setenv AVERAGE   g${lab}av
	setenv SUMMARY   g${lab}sum
        setenv PARAMETER tmppar

#    Equilibration   #

	date
        set configurations = "100000"
#       don't waste time doing the perturbations during equilibration
        set lambda = "$rc0 $rc0 $rc0"
	setenv OUTPUT    g${lab}ota
	setenv PLTFILE   g${lab}plta
        echo time $BOSS 111 $configurations $lambda
	time $BOSS 111 $configurations $lambda
	foreach block (eq)
        	date
		setenv OUTPUT    g${lab}ot$block
		setenv PLTFILE   g${lab}plt$block
                echo time $BOSS 001 $configurations $lambda
		time $BOSS 001 $configurations $lambda
	end

#    Averaging   #

#       reset lambda for FEP
        set lambda = "$rc0 $rc1 $rc2"
        set configurations = "500000"
        rm g${lab}sv

	setenv OUTPUT    g${lab}otb
	setenv PLTFILE   g${lab}pltb
        echo time $BOSS 011 $configurations $lambda
	time $BOSS 011 $configurations $lambda
	foreach block (c d e2)
        	date
        	setenv OUTPUT    g${lab}ot$block
        	setenv PLTFILE   g${lab}plt$block
                echo time $BOSS 001 $configurations $lambda
        	time $BOSS 001 $configurations $lambda
	end
        rm g${lab}*a g${lab}*b g${lab}*c g${lab}*d

        if ($i < ($nsteps - 1)) cp g${lab}in g${nex}in

	##### increment 'i' by one.
	@ i++
end

rm slvzmat

date
exit
