#!/bin/csh
#
echo  perform OPLS-AA conjugate gradient optimization
#
# usage - xOPTCG moleculename
#
# test if the enviroment variable MCPROdir has been defined
#
if (!($?MCPROdir)) then
   echo "MCPROdir has not been defined; please see README"
   exit (-1)
endif

if (-e optzmat) rm optzmat
cp ${argv[1]}.z optzmat
csh $MCPROdir/scripts/CGcmd >& log
echo  output is in out, sum and plt.pdb
grep "Optimized en" out
rm optzmat
#
exit
