#!/bin/csh
#
echo  perform single-point AM1 calculation, then
echo  "use 1.07*CM1A charges for GB/SA calculation"
#
# usage - xAM107GB moleculename
#
# test if the enviroment variable BOSSdir has been defined
#
if (!($?BOSSdir)) then
   echo "BOSSdir has not been defined; please see README"
   exit (-1)
endif

if (-e optzmat) rm optzmat
cp ${argv[1]}.z optzmat
csh $BOSSdir/scripts/AM1SP07cmd >& log
rm optzmat
mv sum optzmat
csh $BOSSdir/scripts/SPGBcmd >& log
echo  output is in out, sum and plt.pdb
grep DGsol out
#
exit
