#!/bin/csh
# set echo 
#
# run the nearest residues program for trimming PDB files
#
# usage - xNEAR 
#
# test if the enviroment variable BOSSdir has been defined
# setenv BOSSdir ~/BOSS  
#
if (!($?BOSSdir)) then
    echo "BOSSdir has not been defined; please see README"
    exit (-1)
endif

$BOSSdir/miscexec/nearres 
exit
