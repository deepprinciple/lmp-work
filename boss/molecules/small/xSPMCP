#!/bin/csh
#
echo  perform OPLS-AA single-point with MCPRO
#
# usage - xSP  zmatrixfile
#
# test if the enviroment variable MCPROdir has been defined
#
if (!($?MCPROdir)) then
   echo "MCPROdir has not been defined; please see README"
   exit (-1)
endif

if (-e optzmat) rm optzmat
cp ${argv[1]} optzmat
csh $MCPROdir/cmdpar/SPcmd >& log
echo  output is in out, sum and plt.pdb
#
exit
