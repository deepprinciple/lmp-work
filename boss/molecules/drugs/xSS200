#!/bin/csh
echo "Stochastic Conformational Search"
#
# perform OPLS-AA conformational search
#
# usage - xSS200 moleculename
#
# test if the enviroment variable BOSSdir has been defined
#
if (!($?BOSSdir)) then
   echo "BOSSdir has not been defined; please see README"
   exit (-1)
endif

if (-e optzmat) rm optzmat
cp ${argv[1]}.z optzmat
csh $BOSSdir/scripts/SS200cmd >& log
rm optzmat
if (-e ${argv[1]}.ss.z) rm ${argv[1]}.ss.z
mv svopt ${argv[1]}.ss.z
if (-e ${argv[1]}.ss.out) rm ${argv[1]}.ss.out
mv out ${argv[1]}.ss.out
if (-e ${argv[1]}.ss.mol) rm ${argv[1]}.ss.mol
mv plt.mol ${argv[1]}.ss.mol
if (-e ${argv[1]}.ss.sum) rm ${argv[1]}.ss.sum
mv sum ${argv[1]}.ss.sum

echo "output in "
ls ${argv[1]}.ss.*

#
exit
