function	get_solute_acceptance (n1, n2)
{
	while (getline > 0) {
		if (match($0, "Solute") != 0) {
			n1 = index($0, ":")
			n2 = index($0, "\/")
			nsolutes++;
			nattempt[nsolutes] = substr($0, n1+1, n2-n1-1)
			naccept[nsolutes]  = substr($0, n2+1)
		} else if (match($0, "Solvent")) break;
		if ((nsolutes > 0 && NF == 0) || (nsolutes >= 2)) break;
	}
}

