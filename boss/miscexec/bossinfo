function	get_min_max (xdata, ydata, ndata,	i,x,y)
{
	for(i=1;i<=ndata;i++) {
		x = xdata[i];
		y = ydata[i];
		if (x < xmin) xmin = x;
		if (x > xmax) xmax = x;
		if (y < ymin) ymin = y;
		if (y > ymax) ymax = y;
	}
}

function	reset_min_max ()
{
	xmin =  1000000;
	ymin =  1000000;
	xmax = -1000000;
	ymax = -1000000;
	xdiv =  1000000;
	ydiv =  1000000;
}

function	get_div (nx, ny)
{
	if (nx <= 0) nx = 2;
	if (ny <= 0) ny = 2;
	xdiv = (xmax-xmin)/nx;
	ydiv = (ymax-ymin)/ny;
}

function	reset_y_min_max ()
{
	ymin =  1000000;
	ymax = -1000000;
	ydiv =  1000000;
}

function	get_y_min_max (ydata, ndata,	i,y)
{
	for(i=1;i<=ndata;i++) {
		y = ydata[i];
		if (y < ymin) ymin = y;
		if (y > ymax) ymax = y;
	}
}

function	get_y_div (ny)
{
	if (ny <= 0) ny = 2;
	ydiv = (ymax-ymin)/ny;
}

function	plot_exx (data, ndata, nrun, txt,	i,j,n)
{
	if (nrun < 2 || ndata < 1) return;

	for(i=1;i<=ndata;i++) data[i,nrun] = data[i,0];
	for(i=1;i<=nrun;i++) run[i] = i;

	xmajorticks = nrun-1;
	xminorticks = 1;
	ymajorticks = 5;
	yminorticks = 2;

	xscaled = 1;
	xmin = 1;
	xmax = nrun;

	if (nrun > 10) {
		n = int(nrun/10);
		if (nrun%10 != 0) n++;
		xmax = nrun;
		while ((xmax-1) % n != 0) xmax++;
		xmajorticks = (xmax-1)/n;
	}
	xdiv = (xmax-xmin)/xmajorticks;
	yscaled = 0;

	for(i=1;i<=ndata;i++) {
		exx_n++;
		if (exx_n%2 == 0) exx_xorig = 450; else exx_xorig = 100;

		printf("$Plot: %.3f %.3f\n", exx_xorig, exx_yorig);
		for(j=1;j<=nrun;j++) ydata[j] = data[i,j]

		reset_y_min_max();
		get_y_min_max(ydata, nrun);
		get_y_div(ymajorticks);

		printf("$Plot: %.3f %.3f\n", exx_xorig, exx_yorig);
		print_plot_dev("", "", "", txt[i], 250, 150, "", 0,0,12);
		print_plot_set(run, ydata, errdata, nrun, 0);
		printf("$EndPlot:\n");

		if (exx_n%2 == 0) exx_yorig += 200;
	}
}

function	read_exx (ndata, txt,	nrun)
{
	nrun = 0;
	while (getline > 0) {
		if (NF == 0) break;
		data[1,nrun] = $2;
		data[2,nrun] = $5;
		nrun++;
	}
	if (nrun < 2) return;
	plot_exx(data, ndata, nrun, txt);
}

