function	print_plot_dev (maintitle, subtitle, xtitle, ytitle, w, h, str, xstr, ystr, strsize)
{
	printf("BeginDev:\n");
	printf("   flags = %d\n", 24 + forceticks);
	printf("   dimension = %.3f %.3f\n", w, h);
	printf("   title = 0 0 0 14.0 0 (%s)\n", maintitle);
	printf("   subtitle = 0 0 0 14.0 0 (%s)\n", subtitle);
	if (str != "") printf("   string = %.3f %.3f 0 %.1f 0 (%s)\n", xstr, ystr, strsize, str);
	printf("   tick = 5 7 10\n");
	printf("   BeginAxis 0:\n");
	printf("      dimension = %.3f %.3f %.3f\n", xmin, xmax, xdiv);
	printf("      ticks = %d %d 1\n", xmajorticks, xminorticks);
	printf("      scaling = 0 %d\n", xscaled);
	printf("      title = 0 0 0 14.0 0 (%s)\n", xtitle);
	printf("   EndAxis\n");
	printf("   BeginAxis 1:\n");
	printf("      dimension = %.3f %.3f %.3f\n", ymin, ymax, ydiv);
	printf("      ticks = %d %d 1\n", ymajorticks, yminorticks);
	printf("      scaling = 0 %d\n", yscaled);
	printf("      title = 0 0 0 14.0 0 (%s)\n", ytitle);
	printf("   EndAxis\n");
	printf("EndDev:\n");
}

