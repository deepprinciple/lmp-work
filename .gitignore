bench_runs/**/run_*.log
bench_runs/**/packmol.log
bench_runs/**/packmol_try*.log
bench_runs/**/*live_convergence*.json
bench_runs/**/*live_latest.json
bench_runs/**/*.dat
bench_runs/**/.openff_cache/
bench_runs/**/*.pdb
bench_runs/**/*.xyz

# Local compatibility or temporary parameterization workdirs.
.gpu11_compat_libs/
openff_extchg_*/

# Generated diagnostic output folders from standalone method tests.
diagnostics/methanol_500mol_emd_diag_*/
