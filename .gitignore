__pycache__/
*.py[cod]
*.swp
*.swo
.pytest_cache/
.mypy_cache/
.ruff_cache/
cases/

# Runtime outputs live under bench_runs/. Keep only human-written docs/scripts.
bench_runs/*
!bench_runs/README.md
